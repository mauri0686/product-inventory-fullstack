@using System.Globalization

<div class="table-region" role="region" aria-labelledby="products-table-caption" tabindex="0">
    <table id="products-table">
        <caption id="products-table-caption">Products in inventory</caption>
        <thead>
            <tr>
                <th scope="col" aria-sort="@AriaSort(SortColumn.Name)">
                    <button type="button" class="column-sort" @onclick="() => ToggleSort(SortColumn.Name)">
                        Name<span class="sort-indicator" aria-hidden="true">@Glyph(SortColumn.Name)</span>
                    </button>
                </th>
                <th scope="col" class="numeric-column" aria-sort="@AriaSort(SortColumn.Price)">
                    <button type="button" class="column-sort" @onclick="() => ToggleSort(SortColumn.Price)">
                        Price<span class="sort-indicator" aria-hidden="true">@Glyph(SortColumn.Price)</span>
                    </button>
                </th>
                <th scope="col" class="numeric-column" aria-sort="@AriaSort(SortColumn.Quantity)">
                    <button type="button" class="column-sort" @onclick="() => ToggleSort(SortColumn.Quantity)">
                        Quantity<span class="sort-indicator" aria-hidden="true">@Glyph(SortColumn.Quantity)</span>
                    </button>
                </th>
                <th scope="col" aria-sort="@AriaSort(SortColumn.Status)">
                    <button type="button" class="column-sort" @onclick="() => ToggleSort(SortColumn.Status)">
                        Status<span class="sort-indicator" aria-hidden="true">@Glyph(SortColumn.Status)</span>
                    </button>
                </th>
                <th scope="col" class="actions-column">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in PageProducts)
            {
                <tr @key="product.Id">
                    <td data-label="Name" class="product-name">@product.Name</td>
                    <td data-label="Price" class="numeric-column">@FormatCurrency(product.Price)</td>
                    <td data-label="Quantity" class="numeric-column">@product.Quantity</td>
                    <td data-label="Status">
                        <span class="status-badge @(product.IsActive ? "status-active" : "status-inactive")">
                            <span class="status-dot" aria-hidden="true"></span>
                            @(product.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td data-label="Actions" class="actions-cell">
                        @if (PendingDeleteId == product.Id)
                        {
                            <div class="inline-confirmation" role="alert" aria-label="Delete confirmation">
                                <span>Delete “@product.Name”?</span>
                                <div class="row-actions">
                                    <button class="button button-small button-secondary"
                                            type="button"
                                            autofocus
                                            disabled="@(DeletingProductId is not null)"
                                            @onclick="CancelDeleteAsync">
                                        Cancel
                                    </button>
                                    <button class="button button-small button-danger"
                                            type="button"
                                            disabled="@(DeletingProductId is not null)"
                                            @onclick="() => ConfirmDeleteAsync(product)">
                                        @(DeletingProductId == product.Id ? "Deleting…" : "Delete")
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row-actions">
                                <button class="button button-small button-quiet"
                                        type="button"
                                        disabled="@ActionsDisabled"
                                        @onclick="() => EditAsync(product)">
                                    Edit
                                </button>
                                <button class="button button-small button-quiet button-quiet-danger"
                                        type="button"
                                        disabled="@ActionsDisabled"
                                        @onclick="() => RequestDeleteAsync(product)">
                                    Delete
                                </button>
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (TotalPages > 1)
{
    <nav class="pager" aria-label="Table pagination">
        <button class="button button-small button-secondary"
                type="button"
                disabled="@(ClampedPage <= 1)"
                @onclick="PreviousPage">
            Previous
        </button>
        <span class="pager-status" role="status" aria-live="polite">Page @ClampedPage of @TotalPages</span>
        <button class="button button-small button-secondary"
                type="button"
                disabled="@(ClampedPage >= TotalPages)"
                @onclick="NextPage">
            Next
        </button>
    </nav>
}

@code {
    private static readonly CultureInfo UsCulture = CultureInfo.GetCultureInfo("en-US");

    private enum SortColumn { Name, Price, Quantity, Status }

    private const int PageSize = 10;

    private SortColumn _sortColumn = SortColumn.Name;
    private bool _descending;
    private int _currentPage = 1;

    [Parameter, EditorRequired]
    public IReadOnlyList<ProductResponse> Products { get; set; } = Array.Empty<ProductResponse>();

    [Parameter]
    public Guid? PendingDeleteId { get; set; }

    [Parameter]
    public Guid? DeletingProductId { get; set; }

    [Parameter]
    public bool ActionsDisabled { get; set; }

    [Parameter]
    public EventCallback<ProductResponse> OnEdit { get; set; }

    [Parameter]
    public EventCallback<ProductResponse> OnDeleteRequested { get; set; }

    [Parameter]
    public EventCallback<ProductResponse> OnDeleteConfirmed { get; set; }

    [Parameter]
    public EventCallback OnDeleteCancelled { get; set; }

    private Task EditAsync(ProductResponse product) => OnEdit.InvokeAsync(product);

    private Task RequestDeleteAsync(ProductResponse product) => OnDeleteRequested.InvokeAsync(product);

    private Task ConfirmDeleteAsync(ProductResponse product) => OnDeleteConfirmed.InvokeAsync(product);

    private Task CancelDeleteAsync() => OnDeleteCancelled.InvokeAsync();

    private IReadOnlyList<ProductResponse> SortedProducts
    {
        get
        {
            var ordered = _sortColumn switch
            {
                SortColumn.Price => Order(p => p.Price),
                SortColumn.Quantity => Order(p => p.Quantity),
                SortColumn.Status => Order(p => p.IsActive),
                _ => Order(p => p.Name, StringComparer.OrdinalIgnoreCase),
            };
            return ordered.ThenBy(p => p.Id).ToArray();
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(SortedProducts.Count / (double)PageSize));

    private int ClampedPage => Math.Clamp(_currentPage, 1, TotalPages);

    private IReadOnlyList<ProductResponse> PageProducts =>
        SortedProducts.Skip((ClampedPage - 1) * PageSize).Take(PageSize).ToArray();

    private void PreviousPage() => _currentPage = Math.Max(1, ClampedPage - 1);

    private void NextPage() => _currentPage = Math.Min(TotalPages, ClampedPage + 1);

    private IOrderedEnumerable<ProductResponse> Order<TKey>(
        Func<ProductResponse, TKey> keySelector,
        IComparer<TKey>? comparer = null) =>
        _descending
            ? Products.OrderByDescending(keySelector, comparer)
            : Products.OrderBy(keySelector, comparer);

    private void ToggleSort(SortColumn column)
    {
        if (_sortColumn == column)
        {
            _descending = !_descending;
        }
        else
        {
            _sortColumn = column;
            _descending = false;
        }

        _currentPage = 1;
    }

    private string AriaSort(SortColumn column) =>
        _sortColumn != column ? "none" : _descending ? "descending" : "ascending";

    private string Glyph(SortColumn column) =>
        _sortColumn != column ? string.Empty : _descending ? " ▼" : " ▲";

    private static string FormatCurrency(decimal value) => value.ToString("C2", UsCulture);
}

